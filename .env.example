# ============================================================
#          AI DATA ANALYST PRO - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
#                    API KEYS
# ============================================================

# Groq API Key - Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API Key (Optional) - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here

# ============================================================
#                    STRIPE PAYMENTS
# ============================================================
# Get keys from https://dashboard.stripe.com/apikeys

# Test Mode Keys (for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Live Mode Keys (for production - uncomment when ready)
# STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Stripe Price IDs - Create at https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxx
STRIPE_PRICE_STARTER_YEARLY=price_xxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxxxxxxxxx

# Stripe Webhook Secret - Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================
#                    DATABASE
# ============================================================

APP_DB_PATH=app_database.db
DEFAULT_SAMPLE_DB=Chinook_Sqlite.sqlite
UPLOAD_DIR=uploads

# ============================================================
#                    EMAIL (Optional - for notifications)
# ============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# ============================================================
#                    DEPLOYMENT
# ============================================================

# Update for production deployment
BASE_URL=http://localhost:8501

# Set to False in production
DEBUG=True
